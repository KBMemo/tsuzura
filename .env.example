# 本番用テンプレート。コピー: cp .env.example .env.production
# 開発の bin/dev / bin/rails server はこのファイルを読み込まない（シェル環境 + 下記既定値）。
# 開発で上書きしたいときは .env.development 等を作り、起動前に source する。
#
# DB・RAILS_MASTER_KEY は kbmemo_site と同一 credentials（config/master.key 共有可）

RAILS_MASTER_KEY=
RAILS_ENV=production
PORT=3008

# KBMemo 連携
# 本番デプロイ時: https://media.kbmemo.net
# 開発既定（ENV 未設定）: http://localhost:3008 — bin/dev 起動時は通常不要
TSUZURA_PUBLIC_URL=http://localhost:3008

# KBMemo ↔ /internal/* 用。未設定時は credentials :tsuzura :internal_secret にフォールバック
KBMEMO_TSUZURA_INTERNAL_SECRET=

# Web UI リダイレクト・リンク（開発既定: localhost:3000 — 通常は未設定でよい）
KBMEMO_LOGIN_URL=https://kbmemo.net/login
KBMEMO_HOME_URL=https://kbmemo.net

# ブラウザから /v1/* を credentials 付きで呼ぶ場合（カンマ区切り）
# 開発既定: kbmemo.net + http://localhost:3000
# TSUZURA_CORS_ORIGINS=https://kbmemo.net,https://www.kbmemo.net,http://localhost:3000

# CLI / curl 用 Bearer トークン（tsuzura_…）はアカウントごとに DB 保存。
# KBMemo プロフィールで発行し、シェルに export する（本ファイルには書かない）:
#   export TSUZURA_API_TOKEN=tsuzura_…
#   export TSUZURA_BASE_URL=http://localhost:3008

# Solid Queue を Puma 内で動かす場合（KBMemo と同型）
# SOLID_QUEUE_IN_PUMA=1
