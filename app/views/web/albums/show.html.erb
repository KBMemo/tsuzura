<% content_for :title, "#{@album.title} — Tsuzura" %>

<nav class="breadcrumbs" aria-label="パンくずリスト">
  <%= link_to "アルバム一覧", web_albums_path %>
  <span aria-hidden="true">/</span>
  <span aria-current="page"><%= @album.title %></span>
</nav>

<h2><%= @album.title %></h2>
<p class="muted">album::<code><%= @album.id %></code>[]</p>

<h3>写真を追加</h3>
<%= form_with url: upload_web_album_path(@album), method: :post, multipart: true do %>
  <p>
    <input type="file" name="files[]" accept="image/*" multiple required>
    <button type="submit" class="btn btn-primary">アップロード</button>
  </p>
<% end %>

<h3>登録済み（<%= @items.size %> 件）</h3>
<% if @items.empty? %>
  <p class="muted">まだ写真がありません。</p>
<% else %>
  <ul class="thumbs">
    <% @items.each do |item| %>
      <li class="thumb-card">
        <% if item.web.attached? || item.file.attached? %>
          <%= link_to edit_web_medium_path(item, album_id: @album.id) do %>
            <%= image_tag preview_web_medium_path(item), alt: item.original_filename, class: "thumb-img", width: 160, height: 160, loading: "lazy", decoding: "async" %>
          <% end %>
        <% end %>
        <div class="thumb-meta">
          <span class="thumb-filename"><%= item.original_filename %></span>
          <dl class="thumb-info" aria-label="画像情報">
            <div>
              <dt>日時</dt>
              <dd><%= media_item_capture_time_label(item) %></dd>
            </div>
            <div>
              <dt>位置</dt>
              <dd>
                <% if (map_url = media_item_location_map_url(item)) %>
                  <%= link_to media_item_location_label(item), map_url, target: "_blank", rel: "noopener" %>
                <% else %>
                  <%= media_item_location_label(item) %>
                <% end %>
              </dd>
            </div>
            <div>
              <dt>サイズ</dt>
              <dd><%= media_item_dimensions_label(item) %></dd>
            </div>
            <div>
              <dt>容量</dt>
              <dd><%= media_item_file_size_label(item) %></dd>
            </div>
            <div>
              <dt>種別</dt>
              <dd><%= media_item_content_type_label(item) %></dd>
            </div>
          </dl>
          <span class="thumb-macro">image::media:<code><%= item.id %></code>[]</span>
          <%= link_to "編集", edit_web_medium_path(item, album_id: @album.id), class: "btn" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
