<% content_for :title, "編集 — #{@item.original_filename} — Tsuzura" %>
<% stack = @item.edit_stack.presence || {} %>
<% crop = stack["crop"] || { "x" => 0, "y" => 0, "w" => 1, "h" => 1 } %>

<p><%= link_to "← アルバムへ", web_albums_path %></p>

<h2>写真を編集</h2>
<p class="muted"><code>image::media:<%= @item.id %>[]</code></p>

<% if @item.web.attached? || @item.file.attached? %>
  <p>
    <%= image_tag preview_web_medium_path(@item), alt: @item.original_filename, style: "max-width: 100%; height: auto; border: 1px solid var(--app-border); border-radius: 0.375rem;" %>
  </p>
<% end %>

<%= form_with url: web_medium_path(@item), method: :patch, scope: :edit_stack do |f| %>
  <fieldset style="border: 0; padding: 0; margin: 0 0 1rem;">
    <legend style="font-weight: 600; margin-bottom: 0.5rem;">回転</legend>
    <label>
      <%= f.select :rotate, options_for_select([[ "0°", 0 ], [ "90°", 90 ], [ "180°", 180 ], [ "270°", 270 ]], stack["rotate"].to_i) %>
    </label>
  </fieldset>

  <fieldset style="border: 0; padding: 0; margin: 0 0 1rem;">
    <legend style="font-weight: 600; margin-bottom: 0.5rem;">トリミング（画像に対する割合 0〜1）</legend>
    <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 5rem)); gap: 0.5rem;">
      <%= f.fields_for :crop, crop do |c| %>
        <%= c.label :x, "X" %><%= c.number_field :x, step: 0.01, min: 0, max: 1 %>
        <%= c.label :y, "Y" %><%= c.number_field :y, step: 0.01, min: 0, max: 1 %>
        <%= c.label :w, "幅" %><%= c.number_field :w, step: 0.01, min: 0.01, max: 1 %>
        <%= c.label :h, "高さ" %><%= c.number_field :h, step: 0.01, min: 0.01, max: 1 %>
      <% end %>
    </div>
  </fieldset>

  <p class="muted" style="font-size: 0.8125rem;">ぼかし矩形は API（`blur_regions`）または次の UI 拡張で追加できます。</p>

  <%= f.submit "保存", class: "btn btn-primary" %>
<% end %>
