<% content_for :title, "編集 — #{@item.original_filename} — Tsuzura" %>
<% stack = @item.edit_stack.presence || {} %>
<% crop = stack["crop"] || { "x" => 0, "y" => 0, "w" => 1, "h" => 1 } %>
<% blur_regions = stack["blur_regions"].presence || [] %>

<p><%= link_to "← アルバムへ", web_albums_path %></p>

<h2>写真を編集</h2>
<p class="muted"><code>image::media:<%= @item.id %>[]</code></p>

<% if @item.web.attached? || @item.file.attached? %>
  <p>
    <%= image_tag preview_web_medium_path(@item), alt: @item.original_filename, style: "max-width: 100%; height: auto; border: 1px solid var(--app-border); border-radius: 0.375rem;" %>
  </p>
<% end %>

<%= form_with url: web_medium_path(@item), method: :patch, scope: :edit_stack, id: "edit-stack-form" do |f| %>
  <fieldset style="border: 0; padding: 0; margin: 0 0 1rem;">
    <legend style="font-weight: 600; margin-bottom: 0.5rem;">回転</legend>
    <label>
      <%= f.select :rotate, options_for_select([[ "0°", 0 ], [ "90°", 90 ], [ "180°", 180 ], [ "270°", 270 ]], stack["rotate"].to_i) %>
    </label>
  </fieldset>

  <fieldset style="border: 0; padding: 0; margin: 0 0 1rem;">
    <legend style="font-weight: 600; margin-bottom: 0.5rem;">トリミング（画像に対する割合 0〜1）</legend>
    <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 5rem)); gap: 0.5rem;">
      <%= f.fields_for :crop, crop do |c| %>
        <%= c.label :x, "X" %><%= c.number_field :x, step: 0.01, min: 0, max: 1 %>
        <%= c.label :y, "Y" %><%= c.number_field :y, step: 0.01, min: 0, max: 1 %>
        <%= c.label :w, "幅" %><%= c.number_field :w, step: 0.01, min: 0.01, max: 1 %>
        <%= c.label :h, "高さ" %><%= c.number_field :h, step: 0.01, min: 0.01, max: 1 %>
      <% end %>
    </div>
  </fieldset>

  <fieldset style="border: 0; padding: 0; margin: 0 0 1rem;">
    <legend style="font-weight: 600; margin-bottom: 0.5rem;">ぼかし矩形（正規化座標 0〜1）</legend>
    <p class="muted" style="font-size: 0.8125rem; margin-top: 0;">プライバシー保護用。保存後に表示用 JPEG に焼き込みます。</p>
    <div id="blur-regions" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.75rem;">
      <% blur_regions.each_with_index do |region, index| %>
        <%= render "web/media/blur_region_fields", form: f, index: index, region: region %>
      <% end %>
    </div>
    <p style="margin-top: 0.75rem;">
      <button type="button" class="btn" id="add-blur-region">ぼかし矩形を追加</button>
    </p>
  </fieldset>

  <%= f.submit "保存", class: "btn btn-primary" %>
<% end %>

<template id="blur-region-template">
  <%= render "web/media/blur_region_fields", form: nil, index: "__INDEX__", region: { "x" => 0, "y" => 0, "w" => 0.1, "h" => 0.1, "strength" => 12 } %>
</template>

<script>
  (function () {
    const container = document.getElementById("blur-regions");
    const template = document.getElementById("blur-region-template");
    const addBtn = document.getElementById("add-blur-region");
    if (!container || !template || !addBtn) return;

    const nextIndex = () => container.querySelectorAll("[data-blur-region]").length;

    addBtn.addEventListener("click", () => {
      const html = template.innerHTML.replaceAll("__INDEX__", String(nextIndex()));
      container.insertAdjacentHTML("beforeend", html);
    });

    container.addEventListener("click", (event) => {
      const btn = event.target.closest("[data-remove-blur-region]");
      if (!btn) return;
      const row = btn.closest("[data-blur-region]");
      if (row) row.remove();
    });
  })();
</script>
