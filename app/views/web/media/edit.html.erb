<% content_for :title, "編集 — #{@item.original_filename} — Tsuzura" %>
<% stack = @item.edit_stack.presence || {} %>
<% crop = { "x" => 0, "y" => 0, "w" => 1, "h" => 1 }.merge((stack["crop"] || {}).stringify_keys.compact_blank) %>
<% blur_regions = stack["blur_regions"].presence || [] %>

<nav class="breadcrumbs" aria-label="パンくずリスト">
  <%= link_to "アルバム一覧", web_albums_path %>
  <% if @source_album %>
    <span aria-hidden="true">/</span>
    <%= link_to @source_album.title, web_album_path(@source_album) %>
  <% elsif @source_view == :dates %>
    <span aria-hidden="true">/</span>
    <%= link_to "日付別", web_media_dates_path %>
  <% end %>
  <span aria-hidden="true">/</span>
  <span aria-current="page">写真を編集</span>
</nav>

<h2>写真を編集</h2>
<p class="muted"><code>image::media:<%= @item.id %>[]</code></p>

<%= form_with url: web_medium_path(@item), method: :patch, scope: :edit_stack, id: "edit-stack-form" do |f| %>
  <%= hidden_field_tag :album_id, @source_album.id if @source_album %>
  <%= hidden_field_tag :source, "dates" if @source_view == :dates %>
  <div class="media-edit-layout" data-cropper-editor data-initial-crop="<%= json_escape(crop.to_json) %>">
    <section class="media-edit-preview" aria-label="トリミング範囲">
      <% if @item.file.attached? %>
        <%= image_tag preview_web_medium_path(@item, source: "original"), alt: @item.original_filename, id: "cropper-image", data: { cropper_target: "image" } %>
      <% else %>
        <p class="muted">元画像がありません。</p>
      <% end %>
    </section>

    <aside class="media-edit-panel">
      <fieldset style="border: 0; padding: 0; margin: 0;">
        <legend style="font-weight: 600; margin-bottom: 0.5rem;">回転・トリミング</legend>
        <div class="media-edit-toolbar">
          <label>
            回転
            <%= f.select :rotate, options_for_select([[ "0°", 0 ], [ "90°", 90 ], [ "180°", 180 ], [ "270°", 270 ]], stack["rotate"].to_i), {}, id: "edit-stack-rotate" %>
          </label>
          <button type="button" class="btn" id="reset-crop">全体を選択</button>
        </div>
        <p class="muted" style="margin-bottom: 0.25rem;">画像上でドラッグして残す範囲を選びます。</p>
        <p class="crop-status muted" id="crop-status" aria-live="polite"></p>
        <%= hidden_field_tag "edit_stack[crop][x]", crop["x"], id: "edit_stack_crop_x" %>
        <%= hidden_field_tag "edit_stack[crop][y]", crop["y"], id: "edit_stack_crop_y" %>
        <%= hidden_field_tag "edit_stack[crop][w]", crop["w"], id: "edit_stack_crop_w" %>
        <%= hidden_field_tag "edit_stack[crop][h]", crop["h"], id: "edit_stack_crop_h" %>
      </fieldset>
    </aside>
  </div>

  <fieldset style="border: 0; padding: 0; margin: 1.25rem 0 1rem;">
    <legend style="font-weight: 600; margin-bottom: 0.5rem;">ぼかし矩形（正規化座標 0〜1）</legend>
    <p class="muted" style="font-size: 0.8125rem; margin-top: 0;">プライバシー保護用。保存後に表示用 JPEG に焼き込みます。</p>
    <div id="blur-regions" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.75rem;">
      <% blur_regions.each_with_index do |region, index| %>
        <%= render "web/media/blur_region_fields", form: f, index: index, region: region %>
      <% end %>
    </div>
    <p style="margin-top: 0.75rem;">
      <button type="button" class="btn" id="add-blur-region">ぼかし矩形を追加</button>
    </p>
  </fieldset>

  <%= f.submit "保存", class: "btn btn-primary" %>
<% end %>

<template id="blur-region-template">
  <%= render "web/media/blur_region_fields", form: nil, index: "__INDEX__", region: { "x" => 0, "y" => 0, "w" => 0.1, "h" => 0.1, "strength" => 12 } %>
</template>
