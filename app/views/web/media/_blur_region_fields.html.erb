<% region = (region || {}).stringify_keys %>
<div data-blur-region style="padding: 0.75rem; border: 1px solid var(--app-border); border-radius: 0.375rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
    <span style="font-size: 0.8125rem; font-weight: 600;">矩形</span>
    <button type="button" class="btn" data-remove-blur-region>削除</button>
  </div>
  <div style="display: grid; grid-template-columns: repeat(5, minmax(0, 5rem)); gap: 0.5rem; font-size: 0.875rem;">
    <% prefix = form ? "edit_stack[blur_regions][#{index}]" : "edit_stack[blur_regions][__INDEX__]" %>
    <label>X <input type="number" name="<%= prefix %>[x]" value="<%= region["x"] %>" step="0.01" min="0" max="1"></label>
    <label>Y <input type="number" name="<%= prefix %>[y]" value="<%= region["y"] %>" step="0.01" min="0" max="1"></label>
    <label>幅 <input type="number" name="<%= prefix %>[w]" value="<%= region["w"] %>" step="0.01" min="0.01" max="1"></label>
    <label>高さ <input type="number" name="<%= prefix %>[h]" value="<%= region["h"] %>" step="0.01" min="0.01" max="1"></label>
    <label>強度 <input type="number" name="<%= prefix %>[strength]" value="<%= region["strength"] || 12 %>" step="1" min="1" max="64"></label>
  </div>
</div>
