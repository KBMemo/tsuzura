<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "Tsuzura" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="application-name" content="Tsuzura">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
        --app-text: #18181b;
        --app-muted: #6b7280;
        --app-border: #e5e7eb;
        --app-link: #2563eb;
        --app-surface: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --app-text: #fafafa;
          --app-muted: #a1a1aa;
          --app-border: #3f3f46;
          --app-link: #60a5fa;
          --app-surface: #18181b;
        }
      }
      body {
        margin: 0;
        padding: 1rem 1.25rem 2rem;
        line-height: 1.5;
        max-width: 56rem;
        color: var(--app-text);
        background: var(--app-surface);
      }
      a { color: var(--app-link); }
      .app-header {
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--app-border);
      }
      .app-header-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.25rem;
      }
      .app-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.125rem;
        font-weight: 600;
        letter-spacing: -0.025em;
        color: var(--app-text);
        text-decoration: none;
      }
      .app-brand:hover { opacity: 0.88; }
      .app-brand-icon {
        display: block;
        flex-shrink: 0;
        width: 1.75rem;
        height: 1.75rem;
      }
      .app-tagline {
        margin: 0;
        font-size: 0.875rem;
      }
      .flash { padding: 0.5rem 0.75rem; margin-bottom: 1rem; border-radius: 0.375rem; }
      .flash.notice { background: #ecfdf5; color: #065f46; }
      .flash.alert { background: #fef2f2; color: #991b1b; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--app-border); }
      .btn { display: inline-block; padding: 0.35rem 0.75rem; border-radius: 0.375rem;
        border: 1px solid var(--app-border); background: var(--app-surface); color: var(--app-text);
        text-decoration: none; font-size: 0.875rem; cursor: pointer; }
      .btn-primary { background: #2563eb; color: #fff; border-color: #2563eb; }
      form.inline { display: inline; }
      .muted { color: var(--app-muted); font-size: 0.875rem; }
      ul.thumbs { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
      ul.thumbs li { font-size: 0.875rem; font-family: ui-monospace, monospace; }
    </style>
  </head>
  <body>
    <header class="app-header">
      <nav class="app-header-nav" aria-label="サイト">
        <%= link_to web_albums_path, class: "app-brand" do %>
          <%= tsuzura_brand_icon %>
          <span>Tsuzura</span>
        <% end %>
        <p class="app-tagline muted">KBMemo 写真籠 — <%= link_to "kbmemo.net", kbmemo_home_url, target: "_blank", rel: "noopener" %></p>
      </nav>
    </header>
    <% if flash[:notice].present? %>
      <p class="flash notice"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert].present? %>
      <p class="flash alert"><%= flash[:alert] %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
