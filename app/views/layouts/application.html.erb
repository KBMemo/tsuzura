<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "Tsuzura" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="application-name" content="Tsuzura">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= vite_client_tag %>
    <%= vite_javascript_tag "application" %>
  </head>
  <body>
    <header class="app-header">
      <nav class="app-header-nav" aria-label="サイト">
        <%= link_to web_albums_path, class: "app-brand" do %>
          <%= tsuzura_brand_icon %>
          <span>Tsuzura</span>
        <% end %>
        <div class="app-nav-links">
          <%= link_to "アルバム", web_albums_path %>
          <%= link_to "日付別", web_media_dates_path %>
        </div>
        <p class="app-tagline muted">KBMemo 写真籠 — <%= link_to "kbmemo.net", kbmemo_home_url, target: "_blank", rel: "noopener" %></p>
      </nav>
    </header>
    <% if flash[:notice].present? %>
      <p class="flash notice"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert].present? %>
      <p class="flash alert"><%= flash[:alert] %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
